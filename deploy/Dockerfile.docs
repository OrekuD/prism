# Prism docs — separately deployable static image (task-6 decision, task-8).
# The docs are static HTML built by Astro/Starlight; this image serves them
# with nginx and can be:
#   - run standalone:  docker build -f deploy/Dockerfile.docs -t prism-docs .
#   - run via Compose: docker compose --profile docs up -d docs
# Docs never call out to a third-party host: fonts, logo, search index, and
# styles are all inside the image.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile
COPY . .
# Self-hosted builds override the canonical site so canonical/sitemap URLs
# never point at the public docs origin.
ARG ASTRO_SITE
ENV ASTRO_SITE=${ASTRO_SITE:-}
RUN yarn workspace prism-docs build

FROM nginx:1.27-alpine
COPY deploy/nginx.docs.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/docs/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz >/dev/null 2>&1 || exit 1
