# Prism self-hosted stack configuration.
# Copy to deploy/compose.env and fill in. NEVER commit it.
# Generate secrets with: openssl rand -hex 24

# Public origin — one URL for browser, API, and WebSocket traffic.
# For a local test: http://localhost:3000 (with PUBLIC_PORT=3000).
PUBLIC_URL=http://localhost:3000
PUBLIC_PORT=3000

# Postgres
POSTGRES_USER=prism
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=prism
# Loopback-only psql port (0 disables the mapping)
POSTGRES_PORT=5432

# API secrets — generate each with: openssl rand -hex 24
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM
# Required by the first-owner setup endpoint (used once at /setup)
SETUP_TOKEN=CHANGE_ME_LONG_RANDOM

# Deployment
ENVIRONMENT=production
PRISM_DEPLOYMENT_MODE=self-hosted
INSTANCE_NAME=Prism
SIGNUP_POLICY=disabled

# Object storage: local (default) | s3 | imagekit
STORAGE_DRIVER=local
# S3-compatible example (MinIO):
# STORAGE_DRIVER=s3
# STORAGE_S3_ENDPOINT=http://minio:9000
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BUCKET=prism
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_URL=https://minio.example.com/prism

# Email: SMTP takes precedence over Resend. Without either, no email is
# sent (verification links never leave the instance).
# MAIL_SMTP_HOST=smtp.example.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_SECURE=false
# MAIL_SMTP_USER=
# MAIL_SMTP_PASS=
# MAIL_FROM=Prism <no-reply@example.com>
# RESEND_API_KEY=

# Analytics store auth token (optional for local sqld)
# TURSO_AUTH_TOKEN=

# Optional integrations
# IP_INFO_API_TOKEN=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Analytics retention (task-6): unset or 0 disables deletion (default).
# Run inside the analytics container:
#   docker compose exec analytics node dist/src/retention.js --status
#   docker compose exec analytics node dist/src/retention.js --dry-run
# ANALYTICS_RETENTION_DAYS=30
