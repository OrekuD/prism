# Local development configuration for the Prism web dashboard.
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.

# Required for startup
# ---------------------
# Main API (Cloudflare Worker, started by `yarn workspace prism-api dev`)
VITE_API_URL=http://localhost:8787

# Analytics API (Node, started by `yarn workspace prism-analytics-api dev`)
VITE_WS_API_URL=ws://localhost:8080

# Mapbox public token for the realtime map (https://account.mapbox.com)
VITE_MAPBOX_ACCESS_TOKEN=

# Docs site origin (default: http://localhost:3000).
VITE_DOCS_URL=http://localhost:3000
