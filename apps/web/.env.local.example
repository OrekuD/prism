# Local development configuration for the Prism web dashboard.
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.

# Required for startup
# ---------------------
# Portless dashboard origin. Vite proxies /api to the local Worker.
VITE_API_URL=https://prism.localhost

# Portless dashboard origin. Vite proxies /ws to the local analytics API.
VITE_WS_API_URL=wss://prism.localhost

# Mapbox public token for the realtime map (https://account.mapbox.com)
VITE_MAPBOX_ACCESS_TOKEN=

# Docs site origin under the root Portless configuration.
VITE_DOCS_URL=https://docs.prism.localhost
