# Local development configuration for the Prism analytics API (Node/Hono).
# Copy this file to .env and fill in real values. NEVER commit .env.

# Required for startup
# ---------------------
# Local server port
PORT=8080

# Must match the main API's local JWT secret (apps/api/.dev.vars)
# Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=

# Turso database — the canonical analytics store (sessions live here)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Neon/Postgres product database — used to resolve project API keys and
# WebSocket identities. Use a development-safe Neon branch.
NEONDB_PGHOST=
NEONDB_PGDATABASE=
NEONDB_PGUSER=
NEONDB_PGPASSWORD=
NEONDB_ENDPOINT_ID=

# Optional until IP enrichment is needed
IP_INFO_API_TOKEN=
