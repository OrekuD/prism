# Local development configuration for the Prism analytics API (Node/Hono).
# Copy this file to .env and fill in real values. NEVER commit .env.

# Required for startup
# ---------------------
# Local server port
PORT=8080

# Base URL of the main API (Better Auth JWKS endpoint is derived from it)
AUTH_BASE_URL=http://localhost:8787

# Turso database — the canonical analytics store (sessions live here)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Neon/Postgres product database — used to resolve project API keys and
# WebSocket identities. Use a development-safe Neon branch.
NEONDB_PGHOST=
NEONDB_PGDATABASE=
NEONDB_PGUSER=
NEONDB_PGPASSWORD=
NEONDB_ENDPOINT_ID=

# Optional until IP enrichment is needed
IP_INFO_API_TOKEN=
