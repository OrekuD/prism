{
  "name": "prism-analytics-api",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf ./dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:reset": "tsx src/database/reset.ts",
    "test:coverage": "vitest run --coverage",
    "retention": "tsx src/retention.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.1",
    "@libsql/client": "^0.17.4",
    "@prism-analytics/core": "*",
    "dotenv": "^16.6.1",
    "hono": "^4.13.1",
    "jose": "^6",
    "postgres": "^3.4.9",
    "ua-parser-js": "2.0.10",
    "uuid": "^12.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@prism-analytics/types": "*",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
