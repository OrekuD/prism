# Required for startup
# Copy this file to .dev.vars and fill in real values. NEVER commit .dev.vars.
# Use a development-safe Neon branch, never production.

# Existing Neon/Postgres product database (development branch)
DATABASE_URL=

# Long random secret — signs Better Auth sessions and encrypts the JWKS
# private key. Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=

# Deployment URL of this API. Used as the Better Auth base URL, cookie
# scope, and issuer for service JWTs. Local development:
BASE_URL=http://localhost:8787

# development | production (secure cookies only in production)
ENVIRONMENT=development
# Required by the first-owner setup endpoint when set (always in
# production self-hosted deployments). Generate: openssl rand -hex 24
# SETUP_TOKEN=

# Web dashboard origin, used for links in emails and CORS.
# NOTE: wrangler does NOT hot-reload .dev.vars — restart the API
# (yarn workspace prism-api dev) after changing this file.
CLIENT_URL=http://localhost:3001

# Optional: extra comma-separated dashboard origins allowed by CORS
# CORS_ALLOWED_ORIGINS=https://app.prism.example.com

# Deployment mode: hosted (default) or self-hosted. Self-hosted mode has no
# Prism cloud control-plane dependency and defaults to closed registration.
PRISM_DEPLOYMENT_MODE=hosted

# Instance name shown in the auth shell and config endpoint
INSTANCE_NAME=Prism

# Registration policy: open | invite-only | disabled
# (legacy ALLOW_PUBLIC_SIGNUP=false still maps to disabled)
# Self-hosted instances: close registration after the first owner exists:
# SIGNUP_POLICY=disabled

# Optional social providers (enabled only when BOTH id and secret are set).
# Callback URLs (configure these in the provider dashboards):
#   GitHub:  {BASE_URL}/api/auth/callback/github
#   Google:  {BASE_URL}/api/auth/callback/google
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email: Resend when set; otherwise a development console adapter prints the
# verification/reset links to the server log.
RESEND_API_KEY=

# Optional until upload flows are tested
IMAGE_KIT_API_KEY=

# Application identity
PROJECT_NAME=prism_local

# Analytics: Turso (canonical analytics store) and IP enrichment
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
IP_INFO_API_TOKEN=
