{
  "name": "prism-api",
  "version": "0.0.1",
  "scripts": {
    "dev": "wrangler dev src/index.ts",
    "deploy": "wrangler deploy --minify src/index.ts",
    "start": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "lint": "biome lint ./src",
    "cf-typegen": "wrangler types",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:inspect": "tsx src/database/inspect.ts",
    "db:generate": "drizzle-kit generate",
    "db:drop-tables": "tsx src/database/drop-tables.ts",
    "db:reinstall": "rm -rf drizzle/** && yarn db:drop-tables && yarn db:generate && yarn db:migrate",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^0.19.10",
    "@hono/zod-validator": "^0.9.0",
    "@libsql/client": "^0.17.4",
    "@neondatabase/serverless": "^1.1.0",
    "@prism/types": "*",
    "@tsndr/cloudflare-worker-jwt": "^3.2.2",
    "bcryptjs": "^3.0.3",
    "date-fns": "^3.6.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "postgres": "^3.4.9",
    "resend": "^6.18.1",
    "ulidx": "^2.3.0",
    "uuid": "^12.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/bcryptjs": "^3.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.120.0"
  }
}
