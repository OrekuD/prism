# Node runtime configuration (self-hosted / local without wrangler).
# Copy to .env and fill in. NEVER commit .env.
# Worker deployments use .dev.vars instead; the variable names are identical.

# Required
# ------------------------------------------------------------------
# Plain PostgreSQL (local or managed). Neon-style pooled URLs work too.
DATABASE_URL=postgres://prism:CHANGE_ME@localhost:5432/prism
# Long random secret: openssl rand -hex 32
JWT_SECRET_KEY=
# Public URL of THIS API (auth cookies, callbacks, JWKS). Behind a reverse
# proxy this is the external origin, e.g. https://analytics.example.com
BASE_URL=http://localhost:8787
# Dashboard origin (CORS allowlist, email links)
CLIENT_URL=http://localhost:3001

# Deployment (task-6)
# ------------------------------------------------------------------
# hosted (default) or self-hosted
PRISM_DEPLOYMENT_MODE=hosted
# Instance name shown in the auth shell and config endpoint
INSTANCE_NAME=Prism
# Registration policy: open | invite-only | disabled
SIGNUP_POLICY=open
# Legacy alias: ALLOW_PUBLIC_SIGNUP=true maps to SIGNUP_POLICY=open
# development | production (secure cookies only in production)
ENVIRONMENT=development
# Required for first-owner setup in production self-hosted deployments:
# the public POST /api/v1/setup/owner endpoint demands this token
# (X-Setup-Token header). Generate: openssl rand -hex 24
# SETUP_TOKEN=
# Port for the Node server
PORT=8787

# Optional integrations (all fall back gracefully)
# ------------------------------------------------------------------
# Email: SMTP takes precedence over Resend. Without either, development
# prints verification/reset links to the server log.
# MAIL_SMTP_HOST=smtp.example.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_SECURE=false
# MAIL_SMTP_USER=
# MAIL_SMTP_PASS=
# MAIL_FROM=Prism <no-reply@example.com>
# RESEND_API_KEY=

# Social providers (enabled only when BOTH id and secret are set).
# Callbacks: {BASE_URL}/api/auth/callback/{github|google}
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Analytics store (optional; events/sessions read from it. Without it,
# analytics reads return empty and the rest of the instance works).
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Object storage (task-6): imagekit (default) | s3 | local
# - imagekit: hosted default; needs IMAGE_KIT_API_KEY.
# - s3: any S3-compatible endpoint (MinIO); STORAGE_PUBLIC_URL is the
#   public base URL for objects (may include the bucket prefix path).
# - local: files on disk (STORAGE_LOCAL_DIR), served by the API at /files/*
STORAGE_DRIVER=local
# STORAGE_S3_ENDPOINT=http://minio:9000
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BUCKET=prism
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_URL=http://localhost:9000/prism
# STORAGE_LOCAL_DIR=./data/uploads

# IP enrichment (optional, non-blocking)
# IP_INFO_API_TOKEN=

# Extra dashboard origins, comma-separated
# CORS_ALLOWED_ORIGINS=https://app.example.com
