---
import { Icon } from '@astrojs/starlight/components';
import Search from '@astrojs/starlight/components/Search.astro';
import SkipLink from '@astrojs/starlight/components/SkipLink.astro';
import prismMark from '../assets/prism-mark.svg?raw';

// Contextual product action. Self-hosted deployments serve the dashboard on
// the same origin (docs proxied under /docs), so "/" is the instance
// dashboard. Hosted builds set PUBLIC_DASHBOARD_URL at build time.
const dashboardHref = import.meta.env.PUBLIC_DASHBOARD_URL ?? '/';
// Custom pages (homepage/404) have no Starlight frame header, so they
// render the banner landmark themselves; Starlight pages render a div
// inside the frame's <header> to avoid nested banners.
const { banner = false } = Astro.props;
const Tag = banner ? 'header' : 'div';
---

<Tag class="site-header" data-banner={banner ? "" : undefined}>
		<SkipLink />
		<div class="header prism-header">
		<a href="/" class="prism-brand" aria-label="Prism Docs home">
			<span class="prism-brand__mark" aria-hidden="true" set:html={prismMark} />
			<span class="prism-brand__name" translate="no">Prism</span>
			<span class="prism-brand__docs">Docs</span>
		</a>

		<div class="prism-header__actions">
			<Search class="prism-search-trigger" />
			<a
				class="prism-header__link prism-header__link--icon"
				href="https://github.com/OrekuD/prism"
				target="_blank"
				rel="noopener"
				aria-label="Prism on GitHub (opens in a new tab)"
			>
				<Icon name="github" size="1.1em" />
			</a>
			<a class="prism-header__action" href={dashboardHref}>
				Open dashboard
				<svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5">
					<path d="M3 8h9" />
					<path d="M9 4.5 12.5 8 9 11.5" />
				</svg>
			</a>
		</div>
	</div>
</Tag>

<style>
		.site-header {
			/* No violet rail in the docs; the separator is a hairline. On
			   article pages Starlight's frame header draws it; custom pages
			   (banner) draw their own below. */
			border-bottom: 0;
			background: var(--sl-color-bg-nav);
			position: sticky;
			top: 0;
			z-index: 40;
		}
		.site-header[data-banner] {
			border-bottom: 1px solid var(--sl-color-hairline);
		}
		.prism-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			height: calc(var(--sl-nav-height) - 2px);
			padding-inline: var(--sl-sidebar-pad-x, 1.25rem);
			/* The header shares the frame width with content and footer on
			   every page; the frame is centered on wide screens. */
			max-width: var(--prism-frame-width);
			margin-inline: auto;
		}
		.prism-brand {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			text-decoration: none;
			min-height: 44px;
			margin-block: -6px;
			padding-block: 6px;
		}
		.prism-brand__mark :global(svg) {
			display: block;
			width: 22px;
			height: 22px;
		}
		.prism-brand__name {
			font-family: var(--prism-font-sans);
			font-size: 0.9375rem;
			font-weight: 600;
			letter-spacing: -0.01em;
			color: var(--sl-color-text);
		}
		.prism-brand__docs {
			font-family: var(--prism-font-mono);
			font-size: 0.625rem;
			font-weight: 500;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--prism-text-muted);
			border: 1px solid var(--sl-color-hairline);
			border-radius: var(--prism-radius);
			padding: 0.125rem 0.375rem;
		}
		.prism-header__actions {
			display: flex;
			align-items: center;
			gap: 0.375rem;
			flex-shrink: 0;
		}
		.prism-header__actions :global(> *) {
			flex-shrink: 0;
		}
		.prism-header__link {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 44px;
			height: 44px;
			color: var(--prism-text-muted);
			border-radius: var(--prism-radius);
			text-decoration: none;
		}
		.prism-header__link:hover {
			color: var(--sl-color-text);
			background: var(--prism-surface-hover);
		}
		.prism-header__action {
			display: inline-flex;
			align-items: center;
			gap: 0.4375rem;
			margin-left: 0.5rem;
			padding: 0 0.875rem;
			height: 36px;
			font-family: var(--prism-font-mono);
			font-size: 0.75rem;
			font-weight: 600;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: #f7f7f9; /* light text-inverse: 5.4:1 on accent */
			background: var(--prism-accent);
			border: 0;
			border-radius: var(--prism-radius);
			text-decoration: none;
			white-space: nowrap;
		}
		.prism-header__action:hover {
			background: var(--prism-accent-hover);
			text-decoration: none;
		}
		.prism-header__action:visited {
			color: #f7f7f9;
		}
		@media (max-width: 40rem) {
			.prism-header__link--icon {
				display: none;
			}
			.prism-header__action {
				display: none;
			}
		}
</style>
