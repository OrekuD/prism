---
// Same value as Starlight's own PageTitle (starlight/constants.ts).
const PAGE_TITLE_ID = '_top';
---

<h1 id={PAGE_TITLE_ID} class="prism-page-title" tabindex="-1">
	{Astro.locals.starlightRoute.entry.data.title}
</h1>
{
	(() => {
		const data = Astro.locals.starlightRoute.entry.data as {
			audience?: string;
			scope?: string;
			lastReviewed?: string;
		};
		const hasMeta = data.audience || data.scope || data.lastReviewed;
		if (!hasMeta) return null;
		return (
			<p class="prism-page-meta">
				{data.audience && (
					<span class="prism-page-meta__item">
						<span class="prism-page-meta__label">Audience</span>
						{data.audience}
					</span>
				)}
				{data.scope && (
					<span class="prism-page-meta__item">
						<span class="prism-page-meta__label">Applies to</span>
						{data.scope}
					</span>
				)}
				{data.lastReviewed && (
					<span class="prism-page-meta__item">
						<span class="prism-page-meta__label">Reviewed</span>
						{data.lastReviewed}
					</span>
				)}
			</p>
		);
	})()
}

<style>
	@layer prism.docs {
		.prism-page-title {
			margin-top: 1rem;
			margin-bottom: 0.25rem;
			font-size: var(--prism-font-title);
			letter-spacing: -0.01em;
		}
		.prism-page-meta {
			display: flex;
			flex-wrap: wrap;
			gap: 0.375rem 1rem;
			margin: 0 0 1.25rem;
			padding: 0.5rem 0;
			border-bottom: 1px solid var(--sl-color-hairline);
		}
		.prism-page-meta__item {
			font-family: var(--prism-font-mono);
			font-size: 0.6875rem;
			color: var(--prism-text-muted);
		}
		.prism-page-meta__label {
			color: var(--prism-text-subtle);
			margin-right: 0.375rem;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			font-size: 0.625rem;
		}
	}
</style>
