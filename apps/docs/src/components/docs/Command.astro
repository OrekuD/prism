---
interface Props {
	/** Terminal prompt label (e.g. `sh`, `host`). */
	label?: string;
	/** Text shown above the command, optional. */
	caption?: string;
}

const { label = 'sh', caption } = Astro.props;
---

<figure class="prism-command">
	{caption && <figcaption class="prism-command__caption">{caption}</figcaption>}
	<div class="prism-command__row">
		<span class="prism-command__label">{label}</span>
		<code class="prism-command__code" tabindex="0" aria-label="Command text — scrollable">
			<slot />
		</code>
		<button
			type="button"
			class="prism-command__copy"
			data-copy
			aria-label="Copy command"
		>
			<svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5">
				<rect x="5.5" y="5.5" width="8" height="8" />
				<path d="M10.5 5.5v-2h-8v8h2" />
			</svg>
			<span data-copy-state>Copy</span>
		</button>
	</div>
</figure>

<script>
	// Copy feedback without moving focus; announces via a live region.
	const buttons = [...document.querySelectorAll<HTMLButtonElement>('.prism-command__copy')];
	const announcer = document.createElement('div');
	announcer.setAttribute('role', 'status');
	announcer.setAttribute('aria-live', 'polite');
	announcer.className = 'sr-only';
	document.body.append(announcer);

	for (const button of buttons) {
		button.addEventListener('click', async () => {
			const code = button.parentElement?.querySelector<HTMLElement>('.prism-command__code');
			if (!code) return;
			const text = code.textContent?.trim() ?? '';
			try {
				await navigator.clipboard.writeText(text);
			} catch {
				// Fallback for non-secure contexts.
				const ta = document.createElement('textarea');
				ta.value = text;
				document.body.append(ta);
				ta.select();
				document.execCommand('copy');
				ta.remove();
			}
			// Focus never moves: the fallback textarea is removed without
			// stealing focus, and we restore it explicitly for safety.
			button.focus({ preventScroll: true });
			const state = button.querySelector('[data-copy-state]');
			if (state) state.textContent = 'Copied';
			announcer.textContent = 'Command copied';
			button.classList.add('prism-command__copy--done');
			window.setTimeout(() => {
				if (state) state.textContent = 'Copy';
				button.classList.remove('prism-command__copy--done');
			}, 2000);
		});
	}
</script>

<style>
	@layer prism.docs {
		.prism-command {
			margin: 1.25rem 0;
			display: grid;
			gap: 0.375rem;
		}
		.prism-command__caption {
			font-family: var(--prism-font-mono);
			font-size: 0.6875rem;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: var(--prism-text-subtle);
		}
		.prism-command__row {
			display: flex;
			align-items: stretch;
			border: 1px solid var(--sl-color-hairline);
			border-radius: var(--prism-radius);
			background: var(--prism-surface);
			overflow: hidden;
		}
		.prism-command__label {
			display: flex;
			align-items: center;
			padding: 0 0.75rem;
			font-family: var(--prism-font-mono);
			font-size: 0.6875rem;
			font-weight: 500;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--prism-text-muted);
			border-right: 1px solid var(--sl-color-hairline);
			background: var(--prism-canvas-subtle);
			user-select: none;
		}
		.prism-command__code {
			flex: 1;
			display: flex;
			align-items: center;
			padding: 0.625rem 0.875rem;
			font-family: var(--prism-font-mono);
			font-size: 0.8125rem;
			line-height: 1.5;
			color: var(--sl-color-text);
			overflow-x: auto;
			white-space: nowrap;
			scrollbar-width: thin;
		}
		.prism-command__copy {
			display: flex;
			align-items: center;
			gap: 0.375rem;
			padding: 0 0.875rem;
			font-family: var(--prism-font-mono);
			font-size: 0.6875rem;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: var(--prism-text-muted);
			background: transparent;
			border: 0;
			border-left: 1px solid var(--sl-color-hairline);
			cursor: pointer;
			min-height: 44px;
			transition: color 120ms ease, background 120ms ease;
		}
		.prism-command__copy:hover {
			color: var(--sl-color-text);
			background: var(--prism-surface-hover);
		}
		.prism-command__copy--done {
			color: var(--prism-success);
		}
		@media (prefers-reduced-motion: reduce) {
			.prism-command__copy {
				transition: none;
			}
		}
	}
</style>
