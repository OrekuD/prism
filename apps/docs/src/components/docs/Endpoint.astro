---
interface Props {
	/** HTTP method. */
	method: 'GET' | 'POST' | 'PUT' | 'PATCH' | 'DELETE';
	/** Full path, e.g. `/api/v1/analytics/sessions`. */
	path: string;
	/** Authentication note. */
	auth: string;
	/** Rate limit note. */
	limits?: string;
}

const { method, path, auth, limits } = Astro.props;
---

<section class="prism-endpoint">
	<div class="prism-endpoint__head">
		<span class:list={['prism-endpoint__method', `prism-endpoint__method--${method.toLowerCase()}`]}>{method}</span>
		<code class="prism-endpoint__path">{path}</code>
	</div>
	<dl class="prism-endpoint__meta">
		<div class="prism-endpoint__meta-row">
			<dt>Auth</dt>
			<dd>{auth}</dd>
		</div>
		{limits && (
			<div class="prism-endpoint__meta-row">
				<dt>Limits</dt>
				<dd>{limits}</dd>
			</div>
		)}
	</dl>
	<div class="prism-endpoint__body"><slot /></div>
</section>

<style>
		.prism-endpoint {
			border: 1px solid var(--sl-color-hairline);
			border-radius: var(--prism-radius);
			background: var(--prism-canvas-subtle);
			margin: 1.25rem 0;
			overflow: hidden;
		}
		.prism-endpoint__head {
			display: flex;
			align-items: center;
			gap: 0.75rem;
			padding: 0.625rem 1rem;
			border-bottom: 1px solid var(--sl-color-hairline);
			background: var(--prism-surface);
		}
		.prism-endpoint__method {
			font-family: var(--prism-font-mono);
			font-size: 0.625rem;
			font-weight: 600;
			letter-spacing: 0.08em;
			padding: 0.1875rem 0.4375rem;
			border: 1px solid;
			border-radius: var(--prism-radius);
		}
		.prism-endpoint__method--get {
			color: var(--prism-info);
			border-color: color-mix(in srgb, var(--prism-info) 45%, transparent);
			background: color-mix(in srgb, var(--prism-info) 10%, transparent);
		}
		.prism-endpoint__method--post {
			color: var(--prism-success);
			border-color: color-mix(in srgb, var(--prism-success) 45%, transparent);
			background: color-mix(in srgb, var(--prism-success) 10%, transparent);
		}
		.prism-endpoint__method--put,
		.prism-endpoint__method--patch {
			color: var(--prism-warning);
			border-color: color-mix(in srgb, var(--prism-warning) 45%, transparent);
			background: color-mix(in srgb, var(--prism-warning) 10%, transparent);
		}
		.prism-endpoint__method--delete {
			color: var(--prism-danger);
			border-color: color-mix(in srgb, var(--prism-danger) 45%, transparent);
			background: color-mix(in srgb, var(--prism-danger) 10%, transparent);
		}
		.prism-endpoint__path {
			font-family: var(--prism-font-mono);
			font-size: 0.84375rem;
			color: var(--sl-color-text);
			overflow-x: auto;
			white-space: nowrap;
		}
		.prism-endpoint__meta {
			display: grid;
			gap: 0;
			margin: 0;
			padding: 0.5rem 1rem;
			border-bottom: 1px solid var(--sl-color-hairline);
		}
		.prism-endpoint__meta-row {
			display: grid;
			grid-template-columns: 5rem 1fr;
			gap: 0.75rem;
			padding: 0.25rem 0;
		}
		.prism-endpoint__meta-row dt {
			font-family: var(--prism-font-mono);
			font-size: 0.6875rem;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: var(--prism-text-subtle);
		}
		.prism-endpoint__meta-row dd {
			margin: 0;
			font-size: 0.875rem;
			color: var(--prism-text-muted);
		}
		.prism-endpoint__body {
			padding: 0.875rem 1rem;
		}
		.prism-endpoint__body > :first-child {
			margin-top: 0;
		}
		.prism-endpoint__body > :last-child {
			margin-bottom: 0;
		}
</style>
