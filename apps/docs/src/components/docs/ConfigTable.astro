---
interface Row {
	name: string;
	requirement: string;
	default: string;
	mode: 'both' | 'hosted' | 'self-hosted';
	secret?: boolean;
	restart?: 'boot' | 'runtime';
}

interface Props {
	caption?: string;
	rows: Row[];
}

const { caption, rows } = Astro.props;

const MODE_LABEL: Record<Row['mode'], string> = {
	both: 'Both',
	hosted: 'Hosted',
	'self-hosted': 'Self-hosted',
};
---

<figure class="prism-config-table">
	{caption && <figcaption class="prism-config-table__caption">{caption}</figcaption>}
	<div class="prism-config-table__scroll" tabindex="0" aria-label="Configuration table — horizontally scrollable">
		<table tabindex="0" aria-label="Configuration table — horizontally scrollable">
			<thead>
				<tr>
					<th scope="col">Variable</th>
					<th scope="col">Requirement</th>
					<th scope="col">Default</th>
					<th scope="col">Mode</th>
					<th scope="col">Secret</th>
					<th scope="col">Applied</th>
				</tr>
			</thead>
			<tbody>
				{rows.map((row) => (
					<tr>
						<td><code>{row.name}</code></td>
						<td>{row.requirement}</td>
						<td>{row.default}</td>
						<td>
							<span class:list={['prism-config-table__mode', `prism-config-table__mode--${row.mode}`]}>
								{MODE_LABEL[row.mode]}
							</span>
						</td>
						<td>{row.secret ? <span class="prism-config-table__secret">Yes</span> : 'No'}</td>
						<td>{row.restart === 'boot' ? 'Boot' : 'Runtime'}</td>
					</tr>
				))}
			</tbody>
		</table>
	</div>
</figure>

<style>
	@layer prism.docs {
		.prism-config-table {
			margin: 1.25rem 0;
			display: grid;
			gap: 0.375rem;
		}
		.prism-config-table__caption {
			font-family: var(--prism-font-mono);
			font-size: 0.6875rem;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: var(--prism-text-subtle);
		}
		.prism-config-table__scroll {
			overflow-x: auto;
			border: 1px solid var(--sl-color-hairline);
			border-radius: var(--prism-radius);
			max-width: none;
		}
		.prism-config-table table {
			border: 0;
			width: 100%;
			min-width: 44rem;
			margin: 0;
		}
		.prism-config-table th {
			background: var(--prism-canvas-subtle);
		}
		.prism-config-table td code {
			font-family: var(--prism-font-mono);
			font-size: 0.75rem;
			color: var(--sl-color-text);
			background: var(--sl-color-bg-inline-code);
			border: 1px solid var(--sl-color-hairline);
			border-radius: var(--prism-radius);
			padding: 0.0625rem 0.3125rem;
			white-space: nowrap;
		}
		.prism-config-table__mode {
			display: inline-flex;
			font-family: var(--prism-font-mono);
			font-size: 0.625rem;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			padding: 0.125rem 0.375rem;
			border: 1px solid var(--sl-color-hairline);
			border-radius: var(--prism-radius);
		}
		.prism-config-table__mode--both {
			color: var(--prism-accent);
			border-color: color-mix(in srgb, var(--prism-accent) 45%, transparent);
			background: color-mix(in srgb, var(--prism-accent-soft) 35%, transparent);
		}
		.prism-config-table__mode--hosted,
		.prism-config-table__mode--self-hosted {
			color: var(--prism-text-muted);
		}
		.prism-config-table__secret {
			font-family: var(--prism-font-mono);
			font-size: 0.625rem;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: var(--prism-warning);
		}
	}
</style>
