---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'note' | 'tip' | 'warning' | 'danger' | 'hosted' | 'self-hosted';

interface Props extends Omit<HTMLAttributes<'aside'>, 'title'> {
	variant?: Variant;
	title?: string;
}

const { variant = 'note', title, ...rest } = Astro.props;

const LABELS: Record<Variant, { label: string; icon: string }> = {
	note: { label: 'Note', icon: 'info' },
	tip: { label: 'Tip', icon: 'check' },
	warning: { label: 'Warning', icon: 'warn' },
	danger: { label: 'Danger', icon: 'warn' },
	hosted: { label: 'Hosted', icon: 'cloud' },
	'self-hosted': { label: 'Self-hosted', icon: 'server' },
};

const { label, icon } = LABELS[variant];
const aria = title ?? label;
---

<aside class:list={['prism-callout', `prism-callout--${variant}`]} {...rest}>
	<p class="prism-callout__label">
		<svg class="prism-callout__icon" aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square">
			{icon === 'info' && <><circle cx="8" cy="8" r="6.5" /><path d="M8 7v4" /><path d="M8 4.75v.5" /></>}
			{icon === 'check' && <><path d="M3 8.5 6.5 12 13 4.5" /></>}
			{icon === 'warn' && <><path d="M8 2 14.5 13.5H1.5Z" /><path d="M8 6.5V9.5" /><path d="M8 11.25v.5" /></>}
			{icon === 'cloud' && <><path d="M4 12h7.5a3 3 0 0 0 .4-5.97A5 5 0 0 0 2.2 8.5 2.5 2.5 0 0 0 4 12Z" /></>}
			{icon === 'server' && <><rect x="2" y="3" width="12" height="4.5" /><rect x="2" y="8.5" width="12" height="4.5" /><path d="M4.75 5.25v.5" /><path d="M4.75 10.75v.5" /></>}
		</svg>
		<span>{aria}</span>
	</p>
	<div class="prism-callout__body"><slot /></div>
</aside>

<style>
	@layer prism.docs {
		.prism-callout {
			border: 1px solid var(--sl-color-hairline);
			border-left-width: 2px;
			border-radius: var(--prism-radius);
			background: var(--prism-canvas-subtle);
			padding: 0.75rem 1rem;
			margin: 1.25rem 0;
		}
		.prism-callout__label {
			display: flex;
			align-items: center;
			gap: 0.375rem;
			font-family: var(--prism-font-mono);
			font-size: 0.6875rem;
			font-weight: 500;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--sl-color-text);
			margin: 0 0 0.375rem;
		}
		.prism-callout__icon {
			color: var(--sl-color-callout);
		}
		.prism-callout__body {
			color: var(--sl-color-text);
			font-size: 0.9375rem;
		}
		.prism-callout__body > :first-child {
			margin-top: 0;
		}
		.prism-callout__body > :last-child {
			margin-bottom: 0;
		}
		.prism-callout--note {
			--sl-color-callout: var(--prism-info);
			border-left-color: var(--prism-info);
		}
		.prism-callout--tip {
			--sl-color-callout: var(--prism-success);
			border-left-color: var(--prism-success);
		}
		.prism-callout--warning {
			--sl-color-callout: var(--prism-warning);
			border-left-color: var(--prism-warning);
		}
		.prism-callout--danger {
			--sl-color-callout: var(--prism-danger);
			border-left-color: var(--prism-danger);
		}
		.prism-callout--hosted,
		.prism-callout--self-hosted {
			--sl-color-callout: var(--prism-accent);
			border-left-color: var(--prism-accent);
			background: color-mix(in srgb, var(--prism-accent-soft) 35%, var(--prism-canvas));
		}
	}
</style>
