---
interface Props {
	/** Text rendered after the `//` prefix. */
	label: string;
}

const { label } = Astro.props;
---

<p class="docs-section-label"><span aria-hidden="true">//</span>&nbsp;{label}</p>

<style>
		.docs-section-label {
			font-family: var(--prism-font-mono);
			font-size: 0.6875rem;
			font-weight: 500;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--prism-text-muted);
			margin: 0 0 0.5rem;
			user-select: none;
		}
		.docs-section-label span {
			color: var(--prism-accent);
		}
</style>
