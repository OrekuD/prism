---
interface Props {
	/** Accessible summary of the flow (screen-reader + no-JS equivalent). */
	label: string;
	description: string;
	/** Ordered node list; the last item is the consumer/sink. */
	items: string[];
}

const { label, description, items } = Astro.props;
---

<figure class="prism-flow">
	<figcaption class="prism-flow__caption">{label}</figcaption>
	<ol class="prism-flow__list">
		{items.map((item, index) => (
			<li class="prism-flow__node">
				<span class="prism-flow__index" aria-hidden="true">
					{String(index + 1).padStart(2, '0')}
				</span>
				<span class="prism-flow__text">{item}</span>
			</li>
		))}
	</ol>
	<p class="prism-flow__description">{description}</p>
</figure>

<style>
		.prism-flow {
			border: 1px solid var(--sl-color-hairline);
			border-radius: var(--prism-radius);
			background: var(--prism-canvas-subtle);
			padding: 1rem;
			margin: 1.25rem 0;
			display: grid;
			gap: 0.75rem;
		}
		.prism-flow__caption {
			font-family: var(--prism-font-mono);
			font-size: 0.6875rem;
			font-weight: 500;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--prism-text-muted);
		}
		.prism-flow__list {
			list-style: none;
			margin: 0;
			padding: 0;
			display: grid;
			gap: 0.375rem;
		}
		.prism-flow__node {
			display: grid;
			grid-template-columns: 2rem 1fr;
			align-items: baseline;
			gap: 0.75rem;
			padding: 0.375rem 0.625rem;
			border: 1px solid var(--sl-color-hairline);
			border-radius: var(--prism-radius);
			background: var(--prism-surface);
		}
		.prism-flow__index {
			font-family: var(--prism-font-mono);
			font-size: 0.6875rem;
			color: var(--prism-accent);
		}
		.prism-flow__text {
			font-family: var(--prism-font-mono);
			font-size: 0.8125rem;
			color: var(--sl-color-text);
		}
		.prism-flow__description {
			margin: 0;
			font-size: 0.875rem;
			line-height: 1.6;
			color: var(--prism-text-muted);
		}
</style>
