---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionLabel from '../components/docs/SectionLabel.astro';
import Command from '../components/docs/Command.astro';
import ChoicePanel from '../components/docs/ChoicePanel.astro';
import ThemeProvider from '@astrojs/starlight/components/ThemeProvider.astro';
import '../styles/prism.css';

const { title = 'Prism Docs' } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="theme-color" content="#050506" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#F6F6F8" media="(prefers-color-scheme: light)" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Prism Docs" />
		<meta property="og:title" content="Prism Docs" />
		<meta
			property="og:description"
			content="Documentation for Prism — realtime product analytics for teams, hosted or self-hosted."
		/>
		<meta property="og:image" content={new URL('/og-image.png', Astro.site).toString()} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Prism Docs" />
		<title>{title}</title>
			<ThemeProvider />
	</head>
	<body>
		<Header banner />
		<main id="main-content" class="prism-home">
			<section class="prism-home__hero">
				<SectionLabel label="Prism Docs" />
				<h1 id="_top" tabindex="-1">
					Understand your product
					<span class="prism-home__muted">in realtime</span>
				</h1>
				<p class="prism-home__lede">
					Prism is realtime product analytics for teams: a lightweight
					browser SDK, a high-throughput ingestion service, and a dashboard
					for sessions and events — hosted by us or entirely on your own
					infrastructure.
				</p>
				<div class="prism-home__actions">
					<a class="prism-home__action prism-home__action--primary" href="/hosted/quickstart/">
						Start with hosted Prism
						<svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5">
							<path d="M3 8h9" />
							<path d="M9 4.5 12.5 8 9 11.5" />
						</svg>
					</a>
					<a class="prism-home__action" href="/self-hosting/overview/">
						Self-host Prism
					</a>
				</div>
			</section>

			<section class="prism-home__frame" aria-labelledby="quickstart-heading">
				<div class="prism-home__frame-head">
					<h2 id="quickstart-heading">First event in five minutes</h2>
				</div>
				<div class="prism-home__frame-body">
					<div class="prism-home__code">
						<Command label="sh" caption="Install">
							npm install @prism/core
						</Command>
						<Command label="ts" caption="Initialize">
							import &#123; PrismClient &#125; from "@prism/core";<br />
							const prism = new PrismClient("pr_xxx");
						</Command>
						<Command label="ts" caption="Track">
							await prism.logEvent("button-click", &#123; label: "signup" &#125;);
						</Command>
					</div>
					<div class="prism-home__quickfacts">
						<div class="prism-home__quickfact">
							<span class="prism-home__quickfact-label">Sessions</span>
							<span class="prism-home__quickfact-value">Real-time</span>
							<span class="prism-home__quickfact-detail">New sessions appear live on the dashboard</span>
						</div>
						<div class="prism-home__quickfact">
							<span class="prism-home__quickfact-label">Events</span>
							<span class="prism-home__quickfact-value">Named + structured</span>
							<span class="prism-home__quickfact-detail">Any event name, with optional JSON data</span>
						</div>
						<div class="prism-home__quickfact">
							<span class="prism-home__quickfact-label">Keys</span>
							<span class="prism-home__quickfact-value">Public write-only</span>
							<span class="prism-home__quickfact-detail">Safe to expose in your site's JavaScript</span>
						</div>
					</div>
				</div>
			</section>

			<section class="prism-home__section" aria-labelledby="choose-heading">
				<SectionLabel label="Choose your path" />
				<h2 id="choose-heading">One product, two ways to run it</h2>
				<ChoicePanel
					options={[
						{
							title: 'Hosted',
							href: '/hosted/quickstart/',
							summary: 'Prism operates everything. Create an account, connect a project, ship.',
							points: [
								'Managed stores and infrastructure',
								'Verified email unlocks project creation',
								'No first boot, no setup token',
							],
							action: 'Start hosted',
						},
						{
							title: 'Self-hosted',
							href: '/self-hosting/overview/',
							summary: 'Run the whole stack on your own infrastructure with no outbound access.',
							points: [
								'Single-origin Docker Compose stack',
								'Setup-token first boot, no hosted account',
								'Egress blocked, no telemetry',
							],
							action: 'Self-host',
						},
					]}
				/>
			</section>

			<section class="prism-home__section" aria-labelledby="explore-heading">
				<SectionLabel label="Explore" />
				<h2 id="explore-heading">Go deeper</h2>
				<div class="prism-home__panels">
					<a class="prism-home__panel" href="/sdks/javascript/">
						<span class="prism-home__panel-label">SDKs</span>
						<span class="prism-home__panel-title">JavaScript & React</span>
						<span class="prism-home__panel-desc">
							PrismClient lifecycle, events, and the React provider.
						</span>
					</a>
					<a class="prism-home__panel" href="/api-reference/ingestion/">
						<span class="prism-home__panel-label">API reference</span>
						<span class="prism-home__panel-title">Ingestion endpoints</span>
						<span class="prism-home__panel-desc">
							Sessions, events, auth, limits, and error envelopes.
						</span>
					</a>
					<a class="prism-home__panel" href="/self-hosting/installation/">
						<span class="prism-home__panel-label">Operations</span>
						<span class="prism-home__panel-title">Self-hosting guide</span>
						<span class="prism-home__panel-desc">
							Install, first boot, configuration, backups, upgrades.
						</span>
					</a>
					<a class="prism-home__panel" href="/hosted/authentication/">
						<span class="prism-home__panel-label">Accounts</span>
						<span class="prism-home__panel-title">Authentication</span>
						<span class="prism-home__panel-desc">
							Verification, social sign-in, sessions, service JWTs.
						</span>
					</a>
					<a class="prism-home__panel" href="/self-hosting/troubleshooting/">
						<span class="prism-home__panel-label">Runbook</span>
						<span class="prism-home__panel-title">Troubleshooting</span>
						<span class="prism-home__panel-desc">
							Symptom → cause → command → remediation.
						</span>
					</a>
					<a class="prism-home__panel" href="/contributing/development/">
						<span class="prism-home__panel-label">Contributing</span>
						<span class="prism-home__panel-title">Development</span>
						<span class="prism-home__panel-desc">
							Local stack, architecture, and test conventions.
						</span>
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
		html {
			background: var(--sl-color-bg);
		}
		.prism-home {
			max-width: var(--prism-frame-width);
			margin-inline: 0;
			padding: 2.5rem var(--sl-sidebar-pad-x, 1.25rem) 0;
			display: grid;
			gap: 3.5rem;
			width: 100%;
		}
		.prism-home__hero h1 {
			margin: 0.5rem 0 0.75rem;
			font-size: clamp(1.75rem, 4vw, 2.5rem);
			line-height: 1.15;
			letter-spacing: -0.02em;
			max-width: 26ch;
			text-wrap: balance;
		}
		.prism-home__muted {
			color: var(--prism-text-muted);
		}
		.prism-home__lede {
			margin: 0 0 1.25rem;
			max-width: 58ch;
			font-size: 1.0625rem;
			color: var(--prism-text-muted);
		}
		.prism-home__actions {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			margin-bottom: 1.5rem;
		}
		.prism-home__action {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			height: 44px;
			padding: 0 1.125rem;
			font-family: var(--prism-font-mono);
			font-size: 0.6875rem;
			font-weight: 500;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			border: 1px solid var(--sl-color-hairline);
			border-radius: var(--prism-radius);
			color: var(--sl-color-text);
			text-decoration: none;
		}
		.prism-home__action:hover {
			border-color: var(--prism-border-strong);
			background: var(--prism-surface-hover);
			text-decoration: none;
		}
		.prism-home__action--primary {
			background: var(--prism-accent);
			border: 0;
			color: #f7f7f9; /* light text-inverse: 5.4:1 on accent */
			font-weight: 600;
		}
		.prism-home__action--primary:hover {
			background: var(--prism-accent-hover);
			border-color: var(--prism-accent-hover);
		}
		.prism-home__search {
			display: grid;
			gap: 0.375rem;
			max-width: 30rem;
		}
		.prism-home__search-hint {
			margin: 0;
			font-size: 0.75rem;
			color: var(--prism-text-subtle);
		}
		.prism-home__frame {
			border: 1px solid var(--sl-color-hairline);
			border-radius: var(--prism-radius);
			background: var(--prism-canvas-subtle);
			overflow: hidden;
		}
		.prism-home__frame-head {
			display: flex;
			align-items: baseline;
			justify-content: space-between;
			gap: 1rem;
			padding: 1rem 1.25rem;
			border-bottom: 1px solid var(--sl-color-hairline);
		}
		.prism-home__frame-head h2 {
			margin: 0;
			font-size: 1.0625rem;
		}
		.prism-home__frame-note {
			margin: 0;
			font-family: var(--prism-font-mono);
			font-size: 0.6875rem;
			color: var(--prism-text-subtle);
		}
		.prism-home__frame-body {
			display: grid;
			grid-template-columns: 1.4fr 1fr;
			gap: 0;
		}
		.prism-home__code {
			padding: 1.25rem;
			border-right: 1px solid var(--sl-color-hairline);
		}
		.prism-home__quickfacts {
			display: grid;
			align-content: start;
		}
		.prism-home__quickfact {
			display: grid;
			gap: 0.25rem;
			padding: 1rem 1.25rem;
		}
		.prism-home__quickfact + .prism-home__quickfact {
			border-top: 1px solid var(--sl-color-hairline);
		}
		.prism-home__quickfact-label {
			font-family: var(--prism-font-mono);
			font-size: 0.625rem;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--prism-text-subtle);
		}
		.prism-home__quickfact-value {
			font-family: var(--prism-font-mono);
			font-size: 0.9375rem;
			color: var(--sl-color-text);
		}
		.prism-home__quickfact-detail {
			font-size: 0.8125rem;
			color: var(--prism-text-muted);
		}
		.prism-home__section h2 {
			margin: 0 0 1rem;
			font-size: 1.375rem;
		}
		.prism-home__panels {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			border: 1px solid var(--sl-color-hairline);
			border-radius: var(--prism-radius);
			overflow: hidden;
		}
		.prism-home__panel {
			display: grid;
			gap: 0.3125rem;
			padding: 1rem 1.125rem;
			text-decoration: none;
			position: relative;
		}
		.prism-home__panel:nth-child(3n + 1),
		.prism-home__panel:nth-child(3n + 2),
		.prism-home__panel:nth-child(3n) {
			border-bottom: 1px solid var(--sl-color-hairline);
		}
		.prism-home__panel:not(:nth-child(3n + 1)) {
			border-left: 1px solid var(--sl-color-hairline);
		}
		.prism-home__panel:nth-child(n + 4) {
			border-bottom: 0;
		}
		.prism-home__panel:hover {
			background: var(--prism-surface-hover);
		}
		.prism-home__panel:hover .prism-home__panel-title {
			color: var(--prism-accent-hover);
		}
		.prism-home__panel-label {
			font-family: var(--prism-font-mono);
			font-size: 0.625rem;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--prism-text-subtle);
		}
		.prism-home__panel-title {
			font-size: 0.9375rem;
			font-weight: 600;
			color: var(--sl-color-text);
		}
		.prism-home__panel-desc {
			font-size: 0.8125rem;
			line-height: 1.55;
			color: var(--prism-text-muted);
		}
		@media (max-width: 56rem) {
			.prism-home__frame-body {
				grid-template-columns: 1fr;
			}
			.prism-home__code {
				border-right: 0;
				border-bottom: 1px solid var(--sl-color-hairline);
			}
			.prism-home__panels {
				grid-template-columns: 1fr;
			}
			.prism-home__panel,
			.prism-home__panel:not(:nth-child(3n + 1)),
			.prism-home__panel:nth-child(3n + 1) {
				border-left: 0;
				border-bottom: 1px solid var(--sl-color-hairline);
			}
			.prism-home__panel:last-child {
				border-bottom: 0;
			}
		}
</style>
