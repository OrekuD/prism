{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:analytics-api": "turbo run build --filter=@prism/types --filter=prism-analytics-api",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.9"
  },
  "engines": {
    "node": ">=20"
  },
  "name": "prism",
  "packageManager": "yarn@1.22.19",
  "resolutions": {
    "lodash": "4.18.1",
    "zod": "3.25.76"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
