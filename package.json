{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:analytics-api": "turbo run build --filter=@prism-analytics/types --filter=prism-analytics-api",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.9"
  },
  "engines": {
    "node": ">=20"
  },
  "name": "prism",
  "packageManager": "yarn@1.22.19",
  "resolutions": {
    "brace-expansion": "2.1.4",
    "cross-spawn": "7.0.6",
    "dset": "3.1.4",
    "glob": "10.5.0",
    "js-cookie": "3.0.8",
    "js-yaml": "3.15.1",
    "lodash": "4.18.1",
    "minimatch": "9.0.9",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.3",
    "socket.io-parser": "4.2.7",
    "ws": "8.21.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
