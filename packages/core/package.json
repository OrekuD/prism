{
  "name": "@prism-analytics/core",
  "version": "0.0.3",
  "license": "MIT",
  "scripts": {
    "build": "rm -rf dist && tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@prism-analytics/types": "*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "@vitest/coverage-v8": "^3.2.7",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Prism Analytics SDK core"
}
