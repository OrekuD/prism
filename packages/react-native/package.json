{
  "name": "@prism-analytics/react-native",
  "version": "0.0.1",
  "description": "Prism Analytics SDK for React Native — Expo and bare workflow support",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "react-native": "dist/index.js",
  "exports": {
    ".": {
      "react-native": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "@react-navigation/native": {
      "optional": true
    },
    "expo": {
      "optional": true
    },
    "expo-router": {
      "optional": true
    }
  },
  "dependencies": {
    "@prism-analytics/core": "*"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  }
}
